    "lg":    { "value": "12", "type": "borderRadius", "description": "Padrão de card (rounded-xl)" },
    "xl":    { "value": "16", "type": "borderRadius", "description": "Card grande (rounded-2xl)" },
    "full":  { "value": "9999", "type": "borderRadius", "description": "Pílula/círculo" }
  },
  "boxShadow": {
    "sm": {
      "value": { "x": "0", "y": "1", "blur": "2", "spread": "0", "color": "rgba(16,28,41,0.06)", "type": "dropShadow" },
      "type": "boxShadow"
    },
    "md": {
      "value": { "x": "0", "y": "8", "blur": "24", "spread": "-8", "color": "rgba(16,28,41,0.12)", "type": "dropShadow" },
      "type": "boxShadow"
    },
    "lg": {
      "value": { "x": "0", "y": "24", "blur": "60", "spread": "-24", "color": "rgba(10,19,28,0.35)", "type": "dropShadow" },
      "type": "boxShadow"
    }
  },
  "typography": {
    "h1": { "value": { "fontFamily": "{fontFamily.display}", "fontWeight": "{fontWeight.regular}", "fontSize": "{fontSize.h1}", "lineHeight": "{lineHeight.tight}" }, "type": "typography" },
    "h2": { "value": { "fontFamily": "{fontFamily.display}", "fontWeight": "{fontWeight.regular}", "fontSize": "{fontSize.h2}", "lineHeight": "{lineHeight.tight}" }, "type": "typography" },
    "h3": { "value": { "fontFamily": "{fontFamily.display}", "fontWeight": "{fontWeight.medium}",  "fontSize": "{fontSize.h3}", "lineHeight": "{lineHeight.tight}" }, "type": "typography" },
    "h4": { "value": { "fontFamily": "{fontFamily.display}", "fontWeight": "{fontWeight.medium}",  "fontSize": "{fontSize.h4}", "lineHeight": "{lineHeight.normal}" }, "type": "typography" },
    "body":    { "value": { "fontFamily": "{fontFamily.body}", "fontWeight": "{fontWeight.regular}", "fontSize": "{fontSize.body}",   "lineHeight": "{lineHeight.relaxed}" }, "type": "typography" },
    "bodySm":  { "value": { "fontFamily": "{fontFamily.body}", "fontWeight": "{fontWeight.regular}", "fontSize": "{fontSize.bodySm}", "lineHeight": "{lineHeight.normal}" }, "type": "typography" },
    "caption": { "value": { "fontFamily": "{fontFamily.body}", "fontWeight": "{fontWeight.regular}", "fontSize": "{fontSize.caption}", "lineHeight": "{lineHeight.normal}" }, "type": "typography" },
    "button":  { "value": { "fontFamily": "{fontFamily.body}", "fontWeight": "{fontWeight.medium}",  "fontSize": "{fontSize.bodySm}", "lineHeight": "{lineHeight.normal}" }, "type": "typography" },
    "label":   { "value": { "fontFamily": "{fontFamily.mono}", "fontWeight": "{fontWeight.medium}",  "fontSize": "{fontSize.label}",  "lineHeight": "{lineHeight.normal}", "letterSpacing": "0.18em", "textCase": "uppercase" }, "type": "typography" },
    "number":  { "value": { "fontFamily": "{fontFamily.mono}", "fontWeight": "{fontWeight.medium}",  "fontSize": "{fontSize.h3}",     "lineHeight": "{lineHeight.tight}" }, "type": "typography", "description": "Valores financeiros / métricas (estilo ledger)" }
  }
