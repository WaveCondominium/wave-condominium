      "ink":    { "value": "#22303F", "type": "color", "description": "Texto principal" },
      "grey":   { "value": "#5A6B7C", "type": "color", "description": "Texto secundário" }
    },
    "wave": {
      "50":  { "value": "#F0F4FF", "type": "color" },
      "100": { "value": "#E8EEFF", "type": "color" },
      "200": { "value": "#DDE3FF", "type": "color" },
      "300": { "value": "#C0C8EE", "type": "color" },
      "400": { "value": "#8A91C7", "type": "color" },
      "500": { "value": "#4A5FC1", "type": "color" },
      "600": { "value": "#3730A3", "type": "color" },
      "700": { "value": "#2D3A8C", "type": "color" },
      "800": { "value": "#1E2761", "type": "color" },
      "900": { "value": "#131A47", "type": "color" }
    },
    "semantic": {
      "primary":       { "value": "{color.brand.steel}", "type": "color" },
      "secondary":     { "value": "{color.brand.blue}", "type": "color" },
      "background":    { "value": "{color.brand.light}", "type": "color" },
      "surface":       { "value": "#FFFFFF", "type": "color" },
      "text":          { "value": "{color.brand.ink}", "type": "color" },
      "textSecondary": { "value": "{color.brand.grey}", "type": "color" },
      "border":        { "value": "#E5E9F5", "type": "color" },
      "success":       { "value": "{color.brand.teal}", "type": "color" },
      "warning":       { "value": "#EA580C", "type": "color" },
      "error":         { "value": "#DC2626", "type": "color" },
      "info":          { "value": "{color.brand.blue}", "type": "color" },
      "disabled":      { "value": "#B4B2A9", "type": "color" }
    }
  },
  "fontFamily": {
    "display": { "value": "Montserrat", "type": "fontFamilies", "description": "Títulos" },
    "body":    { "value": "Inter", "type": "fontFamilies", "description": "Corpo/UI" },
    "mono":    { "value": "IBM Plex Mono", "type": "fontFamilies", "description": "Números/dados" }
  },
  "fontWeight": {
