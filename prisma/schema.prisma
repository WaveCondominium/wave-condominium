// ---------------------------------------------------------------------------
// Wave Condominium — schema Prisma
//
// Fundacao PostgreSQL do dominio (SOW Instaward, entregavel 1).
//
// Alem da autenticacao (ja existente), este schema modela:
//  - Administradora (canal B2B2C): gere N condominios (entregavel 2);
//  - Hierarquia de papeis: ADMINISTRADORA > SINDICO > MORADOR (+ ADMIN plataforma);
//  - Os dominios ja construidos no app (hoje em localStorage): Comunicacao
//    (Aviso/Comentario), Reservas (Reserva/Bloqueio), Boletos (Boleto),
//    Governanca (Proposta/Voto) e os registros por unidade do Dashboard.
//
// Todo dado de dominio e escopado por condominiumId, garantindo isolamento
// multi-tenant (um condominio nunca ve dados de outro) — validado no servidor.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy / contas --------------------------------------------------------

model Administradora {
  id           String        @id @default(cuid())
  name         String
  cnpj         String?       @unique
  createdAt    DateTime      @default(now())
  condominiums Condominium[]
  users        User[]
}

model Condominium {
  id               String          @id @default(cuid())
  name             String
  administradoraId String?
  administradora   Administradora? @relation(fields: [administradoraId], references: [id])
  createdAt        DateTime        @default(now())

  // SÍN-026 (financeiro): alçada de aprovação. Despesas com valor ACIMA deste
  // teto exigem aprovação do síndico na Central. null = sem alçada (toda
  // despesa segue direto para PENDENTE — comportamento anterior preservado).
  alcadaAprovacao Decimal? @db.Decimal(12, 2)

  users     User[]
  avisos    Aviso[]
  reservas  Reserva[]
  bloqueios Bloqueio[]
  boletos   Boleto[]
  propostas Proposta[]
  despesas  Despesa[]
  unidades  Unidade[]
  convites  ConviteAcesso[]

  @@index([administradoraId])
}

enum Role {
  ADMIN // Admin de plataforma (Wave)
  ADMINISTRADORA // Empresa que gere multiplos condominios
  SINDICO
  MORADOR
}

model User {
  id           String @id @default(cuid())
  email        String
  passwordHash String
  name         String
  role         Role   @default(MORADOR)
  // Papel adicional opcional — ex.: um Síndico que também é Morador (SÍN-003).
  // Permite ao usuário escolher/alternar o perfil ativo da sessão.
  secondaryRole Role?
  unit         String?
  photoUrl     String?

  // Primeiro acesso: quando true, o usuario DEVE trocar a senha provisoria
  // antes de acessar qualquer funcionalidade da plataforma.
  mustChangePassword Boolean @default(false)

  // SÍN-022: acesso revogado pelo síndico. Quando true, o login é bloqueado e
  // as sessões deixam de ser válidas (verificado no login/guard/getCurrentUser).
  acessoRevogado Boolean @default(false)

  // Vinculo com condominio (sindico/morador) OU administradora.
  condominiumId String?
  condominium   Condominium? @relation(fields: [condominiumId], references: [id])

  administradoraId String?
  administradora   Administradora? @relation(fields: [administradoraId], references: [id])

  sessions  Session[]
  votos     Voto[]
  createdAt DateTime  @default(now())

  @@unique([condominiumId, email])
  @@index([condominiumId])
  @@index([administradoraId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

// --- Comunicacao (Avisos) ----------------------------------------------------

enum Prioridade {
  URGENTE
  ALTA
  NORMAL
}

enum CategoriaAviso {
  ELEVADOR
  AGUA
  ENERGIA
  OBRAS
  CAIXA_DAGUA
  DEDETIZACAO
  SEGURANCA
  EVENTO
  COMUNICADO
}

model Aviso {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  titulo            String
  conteudo          String
  categoria         CategoriaAviso
  prioridade        Prioridade
  autorNome         String
  comentariosAtivos Boolean        @default(true)
  enviarEmail       Boolean        @default(false)

  // Campos opcionais de evento.
  dataEvento    String?
  horarioEvento String?
  localEvento   String?

  publicadoEm DateTime          @default(now())
  comentarios ComentarioAviso[]

  @@index([condominiumId, prioridade])
}

model ComentarioAviso {
  id       String   @id @default(cuid())
  avisoId  String
  aviso    Aviso    @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  autor    String
  conteudo String
  criadoEm DateTime @default(now())

  @@index([avisoId])
}

// --- Reservas de espacos comuns ---------------------------------------------

enum EspacoComum {
  SALAO
  CHURRASQUEIRA
  QUADRA
  GOURMET
}

enum StatusReserva {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

model Reserva {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  espaco         EspacoComum
  data           String // 'YYYY-MM-DD'
  horarioInicio  String
  horarioFim     String
  solicitanteId  String
  solicitante    String
  status         StatusReserva @default(PENDENTE)
  observacoes    String?
  motivoRejeicao String?

  criadaEm    DateTime  @default(now())
  decididaEm  DateTime?
  canceladaEm DateTime?

  @@index([condominiumId, status])
  @@index([condominiumId, espaco, data])
}

model Bloqueio {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  // null = bloqueia todos os espacos naquele dia.
  espaco   EspacoComum?
  data     String // 'YYYY-MM-DD'
  motivo   String?
  criadoPor String
  criadoEm  DateTime @default(now())

  @@index([condominiumId, data])
}

// --- Boletos -----------------------------------------------------------------

enum StatusBoleto {
  PENDING
  PAID
  COMPENSATED
  BLOCKCHAIN_REGISTERED
  OVERDUE
}

enum FormaPagamento {
  PIX
  CARD
  BOLETO
}

model Boleto {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  unitNumber     String
  unitOwner      String
  referenceMonth String // 'YYYY-MM'
  dueDate        String // 'YYYY-MM-DD'
  amount         Decimal      @db.Decimal(10, 2)
  barcode        String
  status         StatusBoleto @default(PENDING)
  description    String

  condominiumFee Decimal @db.Decimal(10, 2) @default(0)
  waterFee       Decimal @db.Decimal(10, 2) @default(0)
  reserveFund    Decimal @db.Decimal(10, 2) @default(0)
  otherFees      Decimal @db.Decimal(10, 2) @default(0)

  paymentMethod          FormaPagamento?
  paidAt                 DateTime?
  compensatedAt          DateTime?
  blockchainHash         String?
  blockchainRegisteredAt DateTime?
  stellarExplorerUrl     String?

  issuedBy  String
  issuedAt  DateTime @default(now())

  // Gestão de cobrança pelo síndico (SÍN-009). O síndico NÃO paga boletos de
  // terceiros — apenas acompanha e faz cobrança. Registro leve, sem tabela nova.
  lastReminderAt        DateTime? // último lembrete de cobrança enviado ao morador
  acordoParcelas        Int?      // nº de parcelas do acordo de parcelamento
  acordoPrimeiraParcela String?   // 'YYYY-MM-DD' — vencimento da 1ª parcela
  acordoObservacao      String?
  acordoRegistradoEm    DateTime?
  acordoRegistradoPor   String?   // nome do gestor que registrou o acordo

  @@index([condominiumId, unitNumber])
  @@index([condominiumId, status])
}

// --- Governanca (DAO) --------------------------------------------------------

enum CategoriaProposta {
  OBRAS
  SEGURANCA
  FINANCEIRO
  EVENTOS
  MELHORIAS
  SUSTENTABILIDADE
  OUTROS
}

enum StatusProposta {
  VOTACAO_ABERTA
  VOTACAO_ENCERRADA
  APROVADA_COMUNIDADE
  FILA_PRIORIDADES
  EM_ASSEMBLEIA
  APROVADA_ASSEMBLEIA
  EM_EXECUCAO
  CONCLUIDA
  REJEITADA
}

enum VotoEscolha {
  APROVO
  REPROVO
  ABSTENCAO
}

model Proposta {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  titulo       String
  descricao    String
  categoria    CategoriaProposta
  autorNome    String
  status       StatusProposta    @default(VOTACAO_ABERTA)
  criadaEm     DateTime          @default(now())
  prazoVotacao DateTime
  encerradaEm  DateTime?
  aprovadaEm   DateTime?

  // Rejeição pelo síndico (SÍN-005). A proposta NUNCA é excluída fisicamente:
  // ao rejeitar, guarda-se o motivo, o responsável e o momento da decisão,
  // preservando a rastreabilidade completa da Governança no histórico.
  motivoRejeicao String?
  rejeitadaPor   String? // nome do responsável pela decisão (auditoria)
  rejeitadaPorId String? // userId do responsável (auditoria)
  rejeitadaEm    DateTime?

  votos Voto[]

  @@index([condominiumId, status])
}

model Voto {
  id         String      @id @default(cuid())
  propostaId String
  proposta   Proposta    @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  escolha    VotoEscolha
  criadoEm   DateTime    @default(now())

  // Voto unico por morador em cada proposta.
  @@unique([propostaId, userId])
  @@index([propostaId])
}

// --- Dashboard do morador: registros por unidade -----------------------------

enum StatusOcorrencia {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model DocumentoUnidade {
  id            String   @id @default(cuid())
  condominiumId String
  unidade       String
  titulo        String
  tipo          String
  data          DateTime @default(now())

  @@index([condominiumId, unidade])
}

model SolicitacaoServico {
  id            String           @id @default(cuid())
  condominiumId String
  unidade       String
  protocolo     String
  tipo          String
  status        StatusOcorrencia @default(ABERTA)
  descricao     String?
  aberturaEm    DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  @@index([condominiumId, unidade])
}

model ManutencaoUnidade {
  id            String           @id @default(cuid())
  condominiumId String
  unidade       String
  data          DateTime
  descricao     String
  categoria     String
  status        StatusOcorrencia @default(CONCLUIDA)
  responsavel   String

  @@index([condominiumId, unidade])
}

// --- Tesouraria: Despesas / pagamentos (SÍN-011) -----------------------------
//
// Registro de despesas e pagamentos do condomínio, com rastreabilidade e
// integridade do comprovante. Escopado por condominiumId (multi-tenant).
//
// Status: persistimos apenas PENDENTE/PAGO. "Vencido" é DERIVADO no aplicativo
// (status PENDENTE + dataVencimento < hoje), no mesmo padrão de `isBoletoOverdue`
// — evita um estado armazenado que precisa ser "corrigido" a cada virada de dia.
//
// Integridade: ao anexar um comprovante, calculamos o SHA-256 dos BYTES do
// arquivo (`comprovanteHash`) e ancoramos esse hash na Stellar (mesmo padrão de
// Boletos), guardando `blockchainTxHash` + `stellarExplorerUrl`. A verificação
// recalcula o hash do arquivo atual e o compara com o hash ancorado no ledger.

enum CategoriaDespesa {
  FOLHA_PAGAMENTO // Folha de pagamento e encargos
  JARDINAGEM // Jardinagem e paisagismo
  LIMPEZA // Limpeza e conservação
  MANUTENCAO_PREDIAL // Manutenção predial
  ELEVADORES // Elevadores
  SEGURANCA_PORTARIA // Segurança e portaria
  AGUA_ESGOTO // Água e esgoto
  ENERGIA // Energia elétrica
  GAS // Gás
  SEGUROS // Seguros
  TAXAS_TRIBUTOS // Taxas e tributos
  ADMINISTRACAO // Administração
  OBRAS_BENFEITORIAS // Obras e benfeitorias
  OUTROS // Outros
}

enum StatusDespesa {
  PENDENTE
  PAGO
  // SÍN-026 (financeiro): despesa acima da alçada aguardando decisão do síndico.
  AGUARDANDO_APROVACAO
  // Reprovada pelo síndico na Central (rastreabilidade; não é excluída).
  REPROVADA
}

enum FormaPagamentoDespesa {
  PIX
  TED
  TRANSFERENCIA
  DINHEIRO
  BOLETO
  CARTAO
  DEBITO_AUTOMATICO
  OUTRO
}

enum OrigemRecursoDespesa {
  SALDO
  FUNDO_RESERVA
}

model Despesa {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  categoria      CategoriaDespesa
  descricao      String
  fornecedor     String? // fornecedor ou beneficiário
  valor          Decimal          @db.Decimal(12, 2)
  dataVencimento String // 'YYYY-MM-DD'
  dataPagamento  String? // 'YYYY-MM-DD' — vazio enquanto pendente
  formaPagamento FormaPagamentoDespesa?
  origemRecurso  OrigemRecursoDespesa  @default(SALDO)
  status         StatusDespesa         @default(PENDENTE)

  // Comprovante + registro de integridade (ancorado na Stellar).
  comprovanteNome        String?
  comprovanteUrl         String? // URL do Vercel Blob
  comprovanteMime        String?
  comprovanteTamanho     Int? // bytes
  comprovanteHash        String? // SHA-256 hex (64 chars) dos bytes do arquivo
  blockchainTxHash       String? // hash da transação Stellar que ancora o comprovante
  blockchainRegisteredAt DateTime?
  stellarExplorerUrl     String?

  registradoPor String // nome do gestor que registrou (auditoria)

  // SÍN-026 (financeiro): rastreabilidade da decisão sobre a alçada.
  aprovadaPor      String?
  aprovadaEm       DateTime?
  reprovadaPor     String?
  reprovadaEm      DateTime?
  motivoReprovacao String?

  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([condominiumId, status])
  @@index([condominiumId, categoria])
}

// --- Unidades (SÍN-021) ------------------------------------------------------
//
// Cadastro estrutural e de ocupação das unidades do condomínio. Escopado por
// condominiumId (multi-tenant). A trilha de auditoria das alterações é
// registrada no módulo Auditoria (client-side + âncora Stellar), fora daqui.
//
// Unicidade: (condominiumId, bloco, numero). `bloco` usa "" (vazio) para "sem
// bloco" — evita o comportamento de NULLs distintos do Postgres e garante a
// deduplicação exigida pela importação em massa.

enum TipoUnidade {
  APARTAMENTO
  SALA
  LOJA
  COBERTURA
  VAGA_AUTONOMA
}

enum StatusUnidade {
  OCUPADA
  VAGA
  EM_OBRA
}

model Unidade {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  // Identificação
  bloco  String @default("") // bloco ou torre ("" = sem bloco)
  andar  String @default("") // andar (texto: "Térreo", "1", "12"...)
  numero String // número da unidade

  // Características
  tipo          TipoUnidade   @default(APARTAMENTO)
  fracaoIdeal   Decimal?      @db.Decimal(9, 6) // fração ideal (ex.: 0.012345)
  areaPrivativa Decimal?      @db.Decimal(10, 2) // m²
  vagas         Int           @default(0)
  status        StatusUnidade @default(VAGA)

  // Vínculos (nome + contato). A unidade pode ter proprietário mesmo vaga.
  proprietarioNome     String?
  proprietarioEmail    String?
  proprietarioTelefone String?
  inquilinoNome        String?
  inquilinoEmail       String?
  inquilinoTelefone    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  convites ConviteAcesso[]

  @@unique([condominiumId, bloco, numero])
  @@index([condominiumId, status])
}

// --- Acessos de moradores (SÍN-022) ------------------------------------------
//
// Convite de acesso gerado pelo Síndico a partir de uma unidade. O morador
// define a própria senha na ativação — o Síndico NUNCA vê/define a senha.
//
// Segurança: guardamos apenas o SHA-256 do token de ativação (`tokenHash`),
// nunca o token em claro. O link tem expiração (`expiresAt`) e uso único
// (após ativar, `status = ATIVADO` e `usadoEm` preenchido). Revogar bloqueia o
// acesso do usuário (User.acessoRevogado) e invalida o convite.
//
// "EXPIRADO" é DERIVADO (PENDENTE + expiresAt < agora), não armazenado.

enum VinculoMorador {
  PROPRIETARIO
  INQUILINO
  DEPENDENTE
}

enum StatusConvite {
  PENDENTE
  ATIVADO
  REVOGADO
}

model ConviteAcesso {
  id            String      @id @default(cuid())
  condominiumId String
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  // Unidade de origem (SÍN-021). Guardamos também o rótulo p/ rastreabilidade
  // mesmo que a unidade seja removida.
  unidadeId     String?
  unidade       Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  unidadeRotulo String

  nome     String
  email    String
  telefone String?
  vinculo  VinculoMorador

  tokenHash String        @unique // SHA-256 hex do token de ativação
  status    StatusConvite @default(PENDENTE)
  expiresAt DateTime

  usuarioId  String? // User criado/ativado por este convite
  usadoEm    DateTime?
  revogadoEm DateTime?
  revogadoPor String?

  criadoPor    String // nome do gestor que gerou o convite (auditoria)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([condominiumId, status])
  @@index([condominiumId, unidadeId])
  @@index([email])
}
