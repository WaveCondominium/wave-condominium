# =============================================================================
# Wave Condominium — Variáveis de ambiente (exemplo)
# Copie para .env / .env.local e preencha. NUNCA commite segredos reais.
# Cada ambiente (desenvolvimento / homologação / produção) usa valores próprios.
# =============================================================================

# Banco de dados PostgreSQL.
# Dev: local. Homologação: banco Neon dedicado (NUNCA o de produção).
# Formato: postgresql://usuario:senha@host:5432/wave?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/wave?schema=public"

# Segredo para assinar a sessão (JWT httpOnly). Gere um valor aleatório longo
# e DIFERENTE por ambiente. Ex.: `openssl rand -base64 48`
WAVE_SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# Conta operacional Stellar (testnet). Opcional em dev; recomendada em homolog/prod.
WAVE_STELLAR_SECRET=""

# Conta administrativa Stellar (testnet). Opcional.
WAVE_ADMIN_STELLAR_SECRET=""

# Origens extras permitidas para Server Actions, separadas por vírgula.
# Em produção/homologação na Vercel normalmente NÃO é necessário: o host do
# deploy é injetado automaticamente (VERCEL_URL / VERCEL_BRANCH_URL). Use apenas
# para domínios customizados. Ex.: "app.wave.com.br,homolog.wave.com.br"
WAVE_ALLOWED_ORIGINS=""
